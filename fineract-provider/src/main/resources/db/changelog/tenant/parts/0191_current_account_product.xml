<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Unique ID for this changeset (use a date or unique string) -->
    <changeSet id="1" author="Daniel Komolafe">

        <!-- Create table for Current Account Products (templates) -->
        <createTable tableName="m_current_account_product">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="short_name" type="varchar(4)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="varchar(500)"/>
            <column name="currency_code" type="varchar(3)" defaultValue="USD">
                <constraints nullable="false"/>
            </column>
            <column name="currency_digits" type="int" defaultValue="2">
                <constraints nullable="false"/>
            </column>
            <column name="min_balance" type="decimal(19,6)"/>
            <column name="overdraft_limit" type="decimal(19,6)"/>
            <column name="product_type_id" type="int" defaultValue="6">
                <constraints nullable="false"/> <!-- Links to ProductType enum ID 6 -->
            </column>
            <!-- Auditing fields (common in Fineract tables) -->
            <column name="createdby_id" type="bigint"/>
            <column name="created_date" type="datetime"/>
            <column name="lastmodifiedby_id" type="bigint"/>
            <column name="lastmodified_date" type="datetime"/>
        </createTable>

        <!-- Add indexes for faster queries (optional but good practice) -->
        <createIndex indexName="name_current_account_product" tableName="m_current_account_product" unique="true">
            <column name="name"/>
        </createIndex>

        <!-- Create table for individual Current Accounts -->
        <createTable tableName="m_current_account">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="client_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="account_no" type="varchar(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="balance" type="decimal(19,6)" defaultValue="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="overdraft_amount" type="decimal(19,6)" defaultValue="0.00"/>
            <column name="status" type="varchar(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <!-- Auditing fields -->
            <column name="createdby_id" type="bigint"/>
            <column name="created_date" type="datetime"/>
            <column name="lastmodifiedby_id" type="bigint"/>
            <column name="lastmodified_date" type="datetime"/>
        </createTable>

        <!-- Add foreign keys (links to existing tables like m_client) -->
        <addForeignKeyConstraint baseTableName="m_current_account" baseColumnNames="client_id"
                                 constraintName="fk_current_account_client" referencedTableName="m_client"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="m_current_account" baseColumnNames="product_id"
                                 constraintName="fk_current_account_product"
                                 referencedTableName="m_current_account_product"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>